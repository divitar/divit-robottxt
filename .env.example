# Copy this file to .env and adjust values before running docker compose.
#
#   cp .env.example .env

# ── Database ───────────────────────────────────────────────────────────────────
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=rootsecret

# ── Ports ──────────────────────────────────────────────────────────────────────
# WordPress site
WP_PORT=8888

# phpMyAdmin
PMA_PORT=8081
