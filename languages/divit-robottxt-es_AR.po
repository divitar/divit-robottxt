#. Plugin Name of the plugin
msgid "Divit RobotTXT"
msgstr "Divit RobotTXT"

#. Plugin URI of the plugin
msgid "https://wordpress.org/plugins/divit-robottxt/"
msgstr ""

#. Description of the plugin
msgid "Manage your robots.txt content from the WordPress admin panel. Content is served via WordPress hook — no file is ever written to disk."
msgstr "Gestioná el contenido de tu robots.txt desde el panel de administración de WordPress. El contenido se sirve a través del hook de WordPress; nunca se escribe ningún archivo en el disco."

#. Author of the plugin
msgid "Divit"
msgstr "Divit"

#: includes/class-divit-robottxt-validator.php
msgid "Line %d exceeds the maximum allowed length of 2048 characters."
msgstr "La línea %d supera la longitud máxima permitida de 2048 caracteres."

#: includes/class-divit-robottxt-validator.php
msgid "Line %1$d is not a valid directive: \"%2$s\". Expected format is \"Directive: value\"."
msgstr "La línea %1$d no es una directiva válida: \"%2$s\". El formato esperado es \"Directiva: valor\"."

#: includes/class-divit-robottxt-validator.php
msgid "Line %1$d contains an unknown directive: \"%2$s\"."
msgstr "La línea %1$d contiene una directiva desconocida: \"%2$s\"."

#: includes/class-divit-robottxt-validator.php
msgid "Line %d: User-agent must have a value (e.g., \"User-agent: *\")."
msgstr "Línea %d: User-agent debe tener un valor (por ejemplo, \"User-agent: *\")."

#: includes/class-divit-robottxt-validator.php
msgid "Line %1$d: Crawl-delay value must be a number. Got: \"%2$s\"."
msgstr "Línea %1$d: el valor de Crawl-delay debe ser un número. Se recibió: \"%2$s\"."

#: includes/class-divit-robottxt-validator.php
msgid "Line %d: Sitemap directive must include a URL."
msgstr "Línea %d: la directiva Sitemap debe incluir una URL."

#: includes/class-divit-robottxt-validator.php
msgid "Line %1$d: Sitemap URL should start with http:// or https://. Got: \"%2$s\"."
msgstr "Línea %1$d: la URL del Sitemap debe comenzar con http:// o https://. Se recibió: \"%2$s\"."

#: includes/class-divit-robottxt-validator.php
msgid "No User-agent directive found. At least one User-agent rule is recommended."
msgstr "No se encontró ninguna directiva User-agent. Se recomienda incluir al menos una regla User-agent."

#: admin/class-divit-robottxt-admin.php
msgid "Divit RobotTXT"
msgstr "Divit RobotTXT"

#: admin/class-divit-robottxt-admin.php
msgid "Security check failed. Please try again."
msgstr "La verificación de seguridad falló. Por favor, intentá de nuevo."

#: admin/class-divit-robottxt-admin.php
msgid "Error"
msgstr "Error"

#: admin/class-divit-robottxt-admin.php
msgid "You do not have permission to change these settings."
msgstr "No tenés permiso para cambiar esta configuración."

#: admin/class-divit-robottxt-admin.php
msgid "Forbidden"
msgstr "Acceso denegado"

#: admin/class-divit-robottxt-admin.php
msgid "This will replace the current content with the recommended template. Continue?"
msgstr "Esto va a reemplazar el contenido actual con la plantilla recomendada. ¿Querés continuar?"

#: admin/class-divit-robottxt-admin.php
msgid "Validating\u2026"
msgstr "Validando\u2026"

#: admin/class-divit-robottxt-admin.php
msgid "Content is valid."
msgstr "El contenido es válido."

#: admin/class-divit-robottxt-admin.php
msgid "Valid, but with warnings:"
msgstr "Válido, pero con advertencias:"

#: admin/class-divit-robottxt-admin.php
msgid "Validation failed:"
msgstr "La validación falló:"

#: admin/class-divit-robottxt-admin.php
msgid "Network error. Please try again."
msgstr "Error de red. Por favor, intentá de nuevo."

#: admin/class-divit-robottxt-ajax.php
msgid "Insufficient permissions."
msgstr "Permisos insuficientes."

#: admin/partials/admin-display.php
msgid "robots.txt content saved successfully."
msgstr "El contenido de robots.txt se guardó correctamente."

#: admin/partials/admin-display.php
msgid "Save failed:"
msgstr "Error al guardar:"

#: admin/partials/admin-display.php
msgid "Physical file detected:"
msgstr "Archivo físico detectado:"

#: admin/partials/admin-display.php
msgid "A robots.txt file exists in your WordPress root directory. Your web server will serve that file directly, bypassing this plugin entirely. Remove the file to use this plugin."
msgstr "Existe un archivo robots.txt en el directorio raíz de WordPress. El servidor web lo va a servir directamente, ignorando este plugin por completo. Eliminá el archivo para usar este plugin."

#: admin/partials/admin-display.php
msgid "Search engines are discouraged:"
msgstr "Motores de búsqueda desactivados:"

#: admin/partials/admin-display.php
msgid "Your site is configured to discourage search engines in %s. This plugin respects that setting and will not override the restrictive robots.txt WordPress generates. Change that setting first to use your custom content."
msgstr "Tu sitio está configurado para desalentar a los motores de búsqueda en %s. Este plugin respeta esa configuración y no va a sobreescribir el robots.txt restrictivo que genera WordPress. Cambiá esa opción primero para usar tu contenido personalizado."

#: admin/partials/admin-display.php
msgid "Reading Settings"
msgstr "Ajustes de lectura"

#: admin/partials/admin-display.php
msgid "Editor toolbar"
msgstr "Barra de herramientas del editor"

#: admin/partials/admin-display.php
msgid "Load Recommended Template"
msgstr "Cargar plantilla recomendada"

#: admin/partials/admin-display.php
msgid "Validate"
msgstr "Validar"

#: admin/partials/admin-display.php
msgid "Quick-add directives"
msgstr "Agregar directivas rápidamente"

#: admin/partials/admin-display.php
msgid "Quick add:"
msgstr "Agregar:"

#: admin/partials/admin-display.php
msgid "robots.txt content"
msgstr "Contenido de robots.txt"

#: admin/partials/admin-display.php
msgid "Each line must be a valid robots.txt directive. Lines beginning with # are treated as comments. Leave blank to use WordPress's default output."
msgstr "Cada línea debe ser una directiva válida de robots.txt. Las líneas que comienzan con # se tratan como comentarios. Dejá en blanco para usar la salida predeterminada de WordPress."

#: admin/partials/admin-display.php
msgid "Save Changes"
msgstr "Guardar cambios"

#: admin/partials/admin-display.php
msgid "View robots.txt"
msgstr "Ver robots.txt"

#: admin/partials/admin-display.php
msgid "Plugin information"
msgstr "Información del plugin"

#: admin/partials/admin-display.php
msgid "Status"
msgstr "Estado"

#: admin/partials/admin-display.php
msgid "Physical robots.txt file found — plugin bypassed"
msgstr "Archivo robots.txt físico encontrado — plugin ignorado"

#: admin/partials/admin-display.php
msgid "No physical robots.txt file"
msgstr "Sin archivo robots.txt físico"

#: admin/partials/admin-display.php
msgid "Site is visible to search engines"
msgstr "El sitio es visible para los motores de búsqueda"

#: admin/partials/admin-display.php
msgid "Discourage search engines is ON"
msgstr "Desalentar motores de búsqueda está ACTIVADO"

#: admin/partials/admin-display.php
msgid "Custom content active"
msgstr "Contenido personalizado activo"

#: admin/partials/admin-display.php
msgid "Using WordPress default"
msgstr "Usando el predeterminado de WordPress"

#: admin/partials/admin-display.php
msgid "Valid Directives"
msgstr "Directivas válidas"

#: admin/partials/admin-display.php
msgid "Target all bots, or a specific bot name."
msgstr "Apuntá a todos los bots, o a uno específico por nombre."

#: admin/partials/admin-display.php
msgid "Block crawlers from a path."
msgstr "Bloqueá los rastreadores en una ruta."

#: admin/partials/admin-display.php
msgid "Explicitly allow a path (overrides Disallow)."
msgstr "Permitís explícitamente una ruta (anula Disallow)."

#: admin/partials/admin-display.php
msgid "Seconds between requests (not all bots honour this)."
msgstr "Segundos entre solicitudes (no todos los bots lo respetan)."

#: admin/partials/admin-display.php
msgid "Full URL to your XML sitemap."
msgstr "URL completa de tu mapa del sitio XML."

#: admin/partials/admin-display.php
msgid "Lines starting with # are ignored by crawlers."
msgstr "Las líneas que comienzan con # son ignoradas por los rastreadores."

#: admin/partials/admin-display.php
msgid "How It Works"
msgstr "Cómo funciona"

#: admin/partials/admin-display.php
msgid "Content is stored in the WordPress database and served dynamically via the robots_txt filter. No file is written to disk."
msgstr "El contenido se almacena en la base de datos de WordPress y se sirve dinámicamente a través del filtro robots_txt. No se escribe ningún archivo en el disco."

#: admin/partials/admin-display.php
msgid "WordPress intercepts requests to /robots.txt when no physical file exists in your site root. If a physical file is found, your server serves it directly and this plugin is bypassed."
msgstr "WordPress intercepta las solicitudes a /robots.txt cuando no existe ningún archivo físico en la raíz del sitio. Si se encuentra un archivo físico, el servidor lo sirve directamente y este plugin queda ignorado."
